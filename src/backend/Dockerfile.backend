# syntax=docker/dockerfile:1
# Build context: repository root (see docker-compose.yml)

ARG PYTHON_VERSION=3.13
ARG NODE_VERSION=24

#### Stage 1: Build frontend (Next.js static export)
FROM node:${NODE_VERSION}-slim AS frontend-builder

WORKDIR /frontend
ENV PNPM_HOME=/pnpm \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

# Install deps from the lockfile first (cached unless manifests change)
COPY src/frontend/package.json src/frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY src/frontend/ ./
# output: "export" in next.config.ts writes the static site to /frontend/out
RUN pnpm build


#### Stage 2: Download and preprocess the dataset
FROM python:${PYTHON_VERSION}-slim AS preprocess
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /bin/uv

WORKDIR /builder
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/builder/.venv

COPY src/backend/pyproject.toml src/backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --only-group preprocess

# Copy only the script so app-code changes don't invalidate this stage
COPY src/backend/core/preprocess_dataset.py ./preprocess_dataset.py

# Cache Hugging Face downloads across builds (the metadata dataset is large)
RUN --mount=type=cache,target=/root/.cache/huggingface \
    .venv/bin/python preprocess_dataset.py && \
    test -f /builder/processed_dataset.parquet


#### Stage 3: Application runtime
FROM python:${PYTHON_VERSION}-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home --uid 1000 appuser

WORKDIR /app

# Runtime deps only (datasets is in the preprocess group and is not installed)
COPY src/backend/pyproject.toml src/backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY --from=preprocess --chown=appuser:appuser /builder/processed_dataset.parquet /data/processed_dataset.parquet
COPY --from=frontend-builder --chown=appuser:appuser /frontend/out /app/static
COPY --chown=appuser:appuser src/backend/ .

USER appuser
EXPOSE 8000

# /api/ returns dataset metadata, so this also verifies the dataset loaded
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/', timeout=5)"]

# Behind a load balancer that terminates HTTPS (e.g. AWS App Runner), trust
# X-Forwarded-* headers so redirects keep the https scheme. Safe because only
# the load balancer can reach the task.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
