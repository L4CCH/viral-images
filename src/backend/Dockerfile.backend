#### Stage 1: Build frontend (Next.js static export)
FROM node:22-slim AS frontend-builder

WORKDIR /frontend

# Install pnpm and dependencies
RUN npm install -g pnpm

# Copy frontend package manifest and install deps (better cache)
COPY src/frontend/package.json ./
RUN pnpm install

# Copy the rest of the frontend source
COPY src/frontend/ ./

# Build a static export (output configured via next.config.ts)
RUN pnpm run export


#### Stage 2: Download and preprocess the dataset
FROM python:3.12-slim AS builder

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /builder

# Install only the dependencies needed for preprocessing
# Using separate RUN for better layer caching
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir \
    datasets \
    pandas \
    pyarrow

# Copy only the preprocessing script and its dependencies from backend source
COPY src/backend/core/ ./core/
COPY src/backend/requirements.txt ./requirements.txt

# Set PYTHONPATH so imports work correctly
ENV PYTHONPATH=/builder

# Run preprocessing (outputs to processed_dataset.parquet in current directory)
RUN python core/preprocess_dataset.py || \
    (echo "Preprocessing failed!" && exit 1)

# Verify the output file was created
RUN test -f /builder/processed_dataset.parquet || \
    (echo "Output file not found!" && exit 1)

#### Stage 3: Application runtime
FROM python:3.12-slim

# Clean up apt cache (no additional runtime deps needed for slim image)
RUN apt-get update && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app /data && \
    chown -R appuser:appuser /app /data

# Set working directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY src/backend/requirements.txt ./requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy the preprocessed dataset from builder stage
COPY --from=builder /builder/processed_dataset.parquet /data/processed_dataset.parquet

# Copy backend application code
COPY --chown=appuser:appuser src/backend/ .

# Copy static frontend build from frontend-builder (Next.js export output)
COPY --from=frontend-builder --chown=appuser:appuser /frontend/out /app/static

# Switch to non-root user
USER appuser

# Expose the port
EXPOSE 8000

# Add health check (using root endpoint as health indicator)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/', timeout=5)" || exit 1

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
